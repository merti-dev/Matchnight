# ── API (apps/api) ────────────────────────────────────────────
# football-data.org ücretsiz anahtarı: güncel sezonun fikstürü ve skorları.
# Boşsa sadece openfootball arşivi kullanılır (güncel sezon görünmez).
FOOTBALL_DATA_TOKEN=
# Senkron aralığı (dakika, en az 5)
SYNC_INTERVAL_MINUTES=30
# Geliştirmede varsayılanlar: data/ repo kökünde, API 3001'de
# MATCHNIGHT_DATA_DIR=./data
# PORT=3001

# ── Web (apps/web) ────────────────────────────────────────────
MATCHNIGHT_API_URL=http://localhost:3001/api
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Künye (Impressum) — Almanya'da ticari sitede zorunlu. Boşsa sayfa "yapılandırılmadı" der.
IMPRINT_NAME=
IMPRINT_ADDRESS=
IMPRINT_EMAIL=
